# Senha de acesso ao painel (obrigatória)
APP_PASSWORD=troque-esta-senha

# Domínio público dos links curtos (sem barra no final). Ex: https://links.belaflor.com.br
# Se vazio, usa o domínio que estiver acessando o painel.
BASE_URL=

PORT=3000
HOST=0.0.0.0

# Opcional: segredo para assinar a sessão (se vazio, é derivado da senha)
SESSION_SECRET=

# Fuso horário em minutos (Brasília = -180)
TZ_OFFSET_MINUTES=-180

# Para onde mandar quem acessar a raiz do domínio (/). Vazio = painel.
ROOT_REDIRECT=

# Por quantos dias a mesma pessoa continua no mesmo comercial
STICKY_DAYS=90

# Caminho do banco SQLite
# DB_PATH=./data/links.db
